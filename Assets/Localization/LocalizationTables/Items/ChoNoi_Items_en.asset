  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 865869e127e5c0e41827bd9ad9d40b55, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1515237298176
    m_Localized: Malk
    m_Metadata:
      m_Items: []
  - m_Id: 1555682971648
    m_Localized: "\"I've heard it makes you stronger, but at the cost of a tummy
      ache. \nA fair and honest trade in the search for power.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1733563404288
    m_Localized: Adds 2 to your <sprite=0> attack roll for 3 turns.
    m_Metadata:
      m_Items: []
  - m_Id: 5430016102400
    m_Localized: Metal Nut
    m_Metadata:
      m_Items: []
  - m_Id: 5430016102401
    m_Localized: Adds 2 to your <sprite=1> attack roll for 3 turns.
    m_Metadata:
      m_Items: []
  - m_Id: 5430016102402
    m_Localized: '"Jet fuel can''t melt steel beams, but you can peddle to the metal."'
    m_Metadata:
      m_Items: []
  - m_Id: 7033259446272
    m_Localized: Light Bulb
    m_Metadata:
      m_Items: []
  - m_Id: 7033259446273
    m_Localized: Adds 2 to your <sprite=2> attack roll for 3 turns.
    m_Metadata:
      m_Items: []
  - m_Id: 7033259446274
    m_Localized: '"The perfect thingamabob to light your day! Just, uh, don''t look
      directly at it for too long."'
    m_Metadata:
      m_Items: []
  - m_Id: 9339111624704
    m_Localized: '"Crunchy on the outside, fluffy on the inside. People will hear
      that crunch a mile away!"'
    m_Metadata:
      m_Items: []
  - m_Id: 9314465894400
    m_Localized: Warp to a selected player on the board. Unusable in combat.
    m_Metadata:
      m_Items: []
  - m_Id: 9159536693248
    m_Localized: Banh Mi
    m_Metadata:
      m_Items: []
  - m_Id: 9512294436864
    m_Localized: '"A street staple filled of deliciousness. Close your eyes and be
      whisked away to a new world of flavor!"'
    m_Metadata:
      m_Items: []
  - m_Id: 9486029705216
    m_Localized: Warp to a selected tile on the board. Unusable in combat.
    m_Metadata:
      m_Items: []
  - m_Id: 9426202152960
    m_Localized: Banh Mi Sandwich
    m_Metadata:
      m_Items: []
  - m_Id: 12254886907904
    m_Localized: Viet Coffee
    m_Metadata:
      m_Items: []
  - m_Id: 12284842627072
    m_Localized: Double your next movement roll for 2 turns.
    m_Metadata:
      m_Items: []
  - m_Id: 12294997037056
    m_Localized: '"Takes minutes to drip, but lasts you hours of your day. Give a
      sip of the real deal!"'
    m_Metadata:
      m_Items: []
  - m_Id: 12182379974656
    m_Localized: Imported Coffee
    m_Metadata:
      m_Items: []
  - m_Id: 12211211620352
    m_Localized: Double your movement roll this turn.
    m_Metadata:
      m_Items: []
  - m_Id: 12235836379136
    m_Localized: '"Imported from where? Who knows, who cares! All that matters is
      that it''s been imported here."'
    m_Metadata:
      m_Items: []
  - m_Id: 11855694024704
    m_Localized: Adds 3 to your next movement roll for 3 turns.
    m_Metadata:
      m_Items: []
  - m_Id: 11902414376960
    m_Localized: '"A trendy drink thats popular with the youngsters. Tames cravings
      in social outings."'
    m_Metadata:
      m_Items: []
  - m_Id: 11631038713856
    m_Localized: Milk Tea
    m_Metadata:
      m_Items: []
  - m_Id: 11616392204288
    m_Localized: '"Roasted notes soothe the soul, while keeping your pulse up! Results
      may vary."'
    m_Metadata:
      m_Items: []
  - m_Id: 11601196240896
    m_Localized: Heal 10-30 and add 2 to your movement roll.
    m_Metadata:
      m_Items: []
  - m_Id: 11545609129984
    m_Localized: Oolong Tea
    m_Metadata:
      m_Items: []
  - m_Id: 11476214370304
    m_Localized: Heal 30 HP and add 1 to your next movement roll.
    m_Metadata:
      m_Items: []
  - m_Id: 11515871514624
    m_Localized: '"The purest tea straight from the tree, reap the rewards of vegetables
      without unnecessary chewing! (Not actual medical advice)"'
    m_Metadata:
      m_Items: []
  - m_Id: 11367267323904
    m_Localized: Green Tea
    m_Metadata:
      m_Items: []
  - m_Id: 11350561411072
    m_Localized: '"Wait, is it black tea or red tea? Either way, it''ll get you going!"'
    m_Metadata:
      m_Items: []
  - m_Id: 11297675431936
    m_Localized: Adds 3 to your next movement roll this turn.
    m_Metadata:
      m_Items: []
  - m_Id: 11239185862656
    m_Localized: Black Tea
    m_Metadata:
      m_Items: []
  - m_Id: 14322863329280
    m_Localized: Heal 15 HP at the start of your turn for 4 turns.
    m_Metadata:
      m_Items: []
  - m_Id: 14332917075968
    m_Localized: '"Salty yet sweet, these preserved plums liven up the mood for an
      unforgettable soda!"'
    m_Metadata:
      m_Items: []
  - m_Id: 14253711839232
    m_Localized: Xi Muoi
    m_Metadata:
      m_Items: []
  - m_Id: 14226461446144
    m_Localized: Heal 15 HP at the start of your turn for 5 turns.
    m_Metadata:
      m_Items: []
  - m_Id: 14237094006784
    m_Localized: '"Said to be beneficial to your health, making your life last longer.
      So you better live long enough to find out!"'
    m_Metadata:
      m_Items: []
  - m_Id: 14180512845824
    m_Localized: Sugarcane Juice
    m_Metadata:
      m_Items: []
  - m_Id: 16269821497344
    m_Localized: Pho
    m_Metadata:
      m_Items: []
  - m_Id: 16315140952064
    m_Localized: '"Proportions too much? Just get it to-go, it''ll last you awhile!
      But mind the tummy-ache."'
    m_Metadata:
      m_Items: []
  - m_Id: 16302096666624
    m_Localized: Double your Max HP for 4 turns.
    m_Metadata:
      m_Items: []
  - m_Id: 16327941967872
    m_Localized: Hanoi Pho
    m_Metadata:
      m_Items: []
  - m_Id: 16353002934272
    m_Localized: Double your Max HP and heal 10% of the damage you deal in battle
      for 3 turns.
    m_Metadata:
      m_Items: []
  - m_Id: 16365808144384
    m_Localized: '"A Northern-style classic. The clear broth makes it obvious why
      its on top!"'
    m_Metadata:
      m_Items: []
  - m_Id: 18736760115200
    m_Localized: Durian
    m_Metadata:
      m_Items: []
  - m_Id: 18768502607872
    m_Localized: Heal 10 HP and heal 20% of the damage you deal in battle for 3 turns.
    m_Metadata:
      m_Items: []
  - m_Id: 18781026799616
    m_Localized: '"Spiky with a pungent scent. Heard its banned in some places, but
      not here!".'
    m_Metadata:
      m_Items: []
  - m_Id: 18867634982912
    m_Localized: Heal 30 HP immediately, then heal 10 HP at the start of the next
      3 turns.
    m_Metadata:
      m_Items: []
  - m_Id: 18825306066944
    m_Localized: Longan
    m_Metadata:
      m_Items: []
  - m_Id: 18939936395264
    m_Localized: '"If you look a little too close at the center, you may see something
      that looks like a dragon''s eye."'
    m_Metadata:
      m_Items: []
  - m_Id: 19032278192128
    m_Localized: Heal 10 HP at the start of the next 3 turns.
    m_Metadata:
      m_Items: []
  - m_Id: 18987629826048
    m_Localized: Lychee
    m_Metadata:
      m_Items: []
  - m_Id: 19046027120640
    m_Localized: '"This little red superstar has won the hearts and tastebuds of
      people all over the world! But don''t swallow the pits."'
    m_Metadata:
      m_Items: []
  - m_Id: 19060019318784
    m_Localized: Cloth
    m_Metadata:
      m_Items: []
  - m_Id: 28263660277760
    m_Localized: Lowers incoming damage by 20 for 1 turn.
    m_Metadata:
      m_Items: []
  - m_Id: 28276478070784
    m_Localized: '"T''was the body of a sentient creature. At least, that''s what
      I was told."'
    m_Metadata:
      m_Items: []
  - m_Id: 28289694322688
    m_Localized: Potato
    m_Metadata:
      m_Items: []
  - m_Id: 28342529970176
    m_Localized: Boosts your next attack's die value by 50%.
    m_Metadata:
      m_Items: []
  - m_Id: 28354664091648
    m_Localized: '"Known as the earth apple and a trusty buddy when things get tough!"'
    m_Metadata:
      m_Items: []
  - m_Id: 28367238615040
    m_Localized: Baked Potato
    m_Metadata:
      m_Items: []
  - m_Id: 28401715793920
    m_Localized: Boosts your next attack's die value by 100%.
    m_Metadata:
      m_Items: []
  - m_Id: 28423815581696
    m_Localized: '"Cooked to a warming smile, share its joy and whimsy with the world."'
    m_Metadata:
      m_Items: []
  - m_Id: 28762383994880
    m_Localized: Trash Bag Mask
    m_Metadata:
      m_Items: []
  - m_Id: 29226416623616
    m_Localized: When you pass a player, steal 1 random item. Effective this turn
      only.
    m_Metadata:
      m_Items: []
  - m_Id: 29236000608256
    m_Localized: '"One Baggie''s trash is another Baggie''s treasure! That other
      Baggie is you."'
    m_Metadata:
      m_Items: []
  - m_Id: 29470642556928
    m_Localized: '"Get kicked back by the heat, but kick back even harder!"'
    m_Metadata:
      m_Items: []
  - m_Id: 29458768482304
    m_Localized: Adds 5 to your <sprite=0> attack roll for 2 turns, but take 35 self-damage
      on use.
    m_Metadata:
      m_Items: []
  - m_Id: 29284855861248
    m_Localized: HOT Chili Sauce
    m_Metadata:
      m_Items: []
  - m_Id: 29676687740928
    m_Localized: Hoa Mai
    m_Metadata:
      m_Items: []
  - m_Id: 29720610492416
    m_Localized: Deploy on a store, which forces the next passing player to stop
      there. Disappears when triggered.
    m_Metadata:
      m_Items: []
  - m_Id: 29733310844928
    m_Localized: '"A popular flower known to bring wealth and prosperity. That''s
      what it''s gonna give you, by the way."'
    m_Metadata:
      m_Items: []
  - m_Id: 29885589245952
    m_Localized: Deploy on any tile, which prevents players from entering that tile.
      Disappears when triggered.
    m_Metadata:
      m_Items: []
  - m_Id: 29746711646208
    m_Localized: Rafflesia
    m_Metadata:
      m_Items: []
  - m_Id: 29899329785856
    m_Localized: '"The world''s largest, worst smelling flower! Rumor has it that
      it eats people..."'
    m_Metadata:
      m_Items: []
  - m_Id: 29911858171904
    m_Localized: Cobra Whiskey
    m_Metadata:
      m_Items: []
  - m_Id: 29951351738368
    m_Localized: The next time you pass a player, end your turn there and fight them
      immediately.
    m_Metadata:
      m_Items: []
  - m_Id: 29956758196224
    m_Localized: '"Completely gruesome, for you and your victim. Why not give it
      (and your victim) a swing?"'
    m_Metadata:
      m_Items: []
  - m_Id: 29978438553600
    m_Localized: Ice Cubes
    m_Metadata:
      m_Items: []
  - m_Id: 30017110036480
    m_Localized: Roll three dice for all dice rolls this turn.
    m_Metadata:
      m_Items: []
  - m_Id: 30026324922368
    m_Localized: '"Fun to chew, but not to eat! So please do so in moderation."'
    m_Metadata:
      m_Items: []
  - m_Id: 3708391078645760
    m_Localized: Rambutan
    m_Metadata:
      m_Items: []
  - m_Id: 3708391103811586
    m_Localized: Coconut
    m_Metadata:
      m_Items: []
  - m_Id: 3708391103811587
    m_Localized: Lowers incoming damage by 15 for 2 turns.
    m_Metadata:
      m_Items: []
  - m_Id: 3708391103811588
    m_Localized: '" "'
    m_Metadata:
      m_Items: []
  - m_Id: 3708391103811589
    m_Localized: Water Coconut
    m_Metadata:
      m_Items: []
  - m_Id: 3708391103811590
    m_Localized: Adds 2 to all your defend rolls for 2 turns.
    m_Metadata:
      m_Items: []
  - m_Id: 3708391103811591
    m_Localized: '"With a jelly-like liquid"'
    m_Metadata:
      m_Items: []
  - m_Id: 3708391103811592
    m_Localized: Pandan Waffle
    m_Metadata:
      m_Items: []
  - m_Id: 3708391103811594
    m_Localized: '" "'
    m_Metadata:
      m_Items: []
  - m_Id: 3708391103811595
    m_Localized: Karaoke Machine
    m_Metadata:
      m_Items: []
  - m_Id: 3708391103811596
    m_Localized: Warp all other players to your current location, then end your turn.
      Unusable in combat.
    m_Metadata:
      m_Items: []
  - m_Id: 3708391103811598
    m_Localized: ???
    m_Metadata:
      m_Items: []
  - m_Id: 3708391103811599
    m_Localized: Remove all traps on the board.
    m_Metadata:
      m_Items: []
  - m_Id: 3708391103811600
    m_Localized: '"bro dont forget to buy this bro, why did you sell the mattock"'
    m_Metadata:
      m_Items: []
  - m_Id: 3708391103811584
    m_Localized: Heal 30 HP immediately, then heal 10 HP at the start of the next
      3 turns.
    m_Metadata:
      m_Items: []
  - m_Id: 3708391103811585
    m_Localized: '"Looks like an alien fruit tastes like a lychee. Don''t let it''s
      tendrils scare you from having something sweet today!"'
    m_Metadata:
      m_Items: []
  references:
