    m_Metadata:
      m_Items: []
  - m_Id: 3522253676236843
    m_Localized: Increasing <sprite=#> [{DICE_FACE_NUMBER}] to <sprite=#> [{DICE_FACE_NUMBER
      + 1}] costs {SP_COST} SP.
